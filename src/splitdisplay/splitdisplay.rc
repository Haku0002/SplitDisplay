#include <windows.h>

#ifndef SD_VER_MAJOR
#define SD_VER_MAJOR 0
#define SD_VER_MINOR 0
#define SD_VER_PATCH 0
#endif

#define SD_STR2(x) #x
#define SD_STR(x) SD_STR2(x)
#define SD_VERSION_STR SD_STR(SD_VER_MAJOR) "." SD_STR(SD_VER_MINOR) "." SD_STR(SD_VER_PATCH) ".0"

1 ICON "splitdisplay.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SD_VER_MAJOR,SD_VER_MINOR,SD_VER_PATCH,0
 PRODUCTVERSION SD_VER_MAJOR,SD_VER_MINOR,SD_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SplitDisplay"
            VALUE "FileDescription", "SplitDisplay virtual monitor compositor"
            VALUE "FileVersion", SD_VERSION_STR
            VALUE "InternalName", "splitdisplay"
            VALUE "OriginalFilename", "splitdisplay.exe"
            VALUE "ProductName", "SplitDisplay"
            VALUE "ProductVersion", SD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
