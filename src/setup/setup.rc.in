#include <windows.h>

#ifndef SD_VER_MAJOR
#define SD_VER_MAJOR @PROJECT_VERSION_MAJOR@
#define SD_VER_MINOR @PROJECT_VERSION_MINOR@
#define SD_VER_PATCH @PROJECT_VERSION_PATCH@
#endif

1 ICON "@CMAKE_SOURCE_DIR@/src/splitdisplay/splitdisplay.ico"
101 RCDATA "@CMAKE_BINARY_DIR@/generated/package.zip"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SplitDisplay"
            VALUE "FileDescription", "SplitDisplay Setup"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "SplitDisplaySetup"
            VALUE "OriginalFilename", "SplitDisplay-Setup.exe"
            VALUE "ProductName", "SplitDisplay"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
